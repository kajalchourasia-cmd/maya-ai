    },
    {
      "data": "workspace causal nodes",
      "disposition": "workspace cascade",
      "object": "public.graph_nodes",
      "retained_after_reset": false
    },
    {
      "data": "workspace causal edges",
      "disposition": "workspace/node cascade",
      "object": "public.graph_edges",
