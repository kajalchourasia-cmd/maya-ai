# Stage 9 local UI: Demo Mode runs without credentials and uses fictional
# fixtures only. Personal Mode requires only the two public Supabase values
# below. Mode/page can be opened locally with ?mode=demo&page=Weekly+Home.

# Public client configuration. Copy this file to .env and fill it locally.
# The publishable key is protected by database RLS; it is not an admin key.
NESTLINE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NESTLINE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Local Supabase CLI/deployment credentials. Never expose these to the app.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Candidate provider keys. Possessing a key does not select a runtime provider.
OPENAI_API_KEY=
XAI_API_KEY=

# Controlled Stage 7 comparison. Keep all inputs fictional. The operator must
# confirm current model prices and set explicit per-request and total CLI caps.
NESTLINE_BENCHMARK_AUTHORIZATION_REFERENCE=
NESTLINE_BENCHMARK_MAX_REQUEST_COST_USD=
NESTLINE_OPENAI_MODEL=
NESTLINE_OPENAI_INPUT_USD_PER_1M=
NESTLINE_OPENAI_OUTPUT_USD_PER_1M=
NESTLINE_OPENAI_RESPONSES_ENDPOINT=https://api.openai.com/v1/responses
NESTLINE_XAI_MODEL=
NESTLINE_XAI_INPUT_USD_PER_1M=
NESTLINE_XAI_OUTPUT_USD_PER_1M=
NESTLINE_XAI_RESPONSES_ENDPOINT=https://api.x.ai/v1/responses

# Runtime selection remains off until benchmark evidence and product review
# select one exact provider/model. The adapter accepts fictional data only and
# sends only a deterministic base summary, never personal facts or evidence.
NESTLINE_ENABLE_LIVE_PROVIDER=false
NESTLINE_LIVE_PROVIDER_DATA_MODE=fictional_only
NESTLINE_GENERATION_PROVIDER=
NESTLINE_GENERATION_MODEL=
NESTLINE_GENERATION_MAX_COST_USD=
NESTLINE_LIVE_PROVIDER_AUTHORIZATION_REFERENCE=
# Stage 4 structured document extraction. Choose an exact model and cost ceiling
# from a measured fictional-data benchmark; there is deliberately no default.
# Keep false in any public deployment. Enable only for supervised fictional demos.
NESTLINE_ENABLE_STAGE4_FIXTURE_DEMO=false
NESTLINE_DOCUMENT_PROVIDER=openai
NESTLINE_DOCUMENT_MODEL=
NESTLINE_DOCUMENT_MAX_COST_USD=

# Real medical uploads stay disabled while the scanner value is unavailable. A
# future scanner adapter and endpoint require a security/platform decision.
NESTLINE_UPLOAD_SCANNER=unavailable
NESTLINE_UPLOAD_SCAN_ENDPOINT=

NESTLINE_EMBEDDING_API_KEY=
NESTLINE_EMBEDDING_PROVIDER=
NESTLINE_EMBEDDING_URL=
NESTLINE_EMBEDDING_MODEL=

# LangSmith tracing/evaluation. Only synthetic or redacted data may be traced.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=nestline-dev
LANGSMITH_WORKSPACE_ID=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Do not place a Supabase service-role/secret key in this file. If a later
# admin-only ingestion job needs one, configure it in the hosting secret store.

# Typed configuration controls. All are fail-closed by default.
NESTLINE_ENABLE_DOCUMENT_PROVIDER=false
NESTLINE_ENABLE_REAL_UPLOADS=false
NESTLINE_TRACE_REDACTION=true
NESTLINE_ALLOW_DEMO_FIXTURES_IN_PERSONAL=false
